# 이 파일을 복사해서 .env로 만드세요: cp .env.example .env
# .env는 절대 커밋하지 마세요 (.gitignore에 포함됨)

# ─── 앱 설정 ──────────────────────────────────────────────────────────────────
APP_ENV=development
APP_VERSION=0.1.0
SECRET_KEY=change-me-to-a-random-32-char-string

# ─── 데이터베이스 ─────────────────────────────────────────────────────────────
# Docker Compose 기본값 (로컬 개발용)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/careercompass

# ─── LLM ──────────────────────────────────────────────────────────────────────
# 로드맵 생성용 Anthropic 키. 비워두거나 "sk-ant-..." 플레이스홀더면 Mock(무료)로
# 동작한다. console.anthropic.com 에서 발급 후 여기에 넣고, 반드시 콘솔에서
# 월 지출 한도(Usage limits)를 먼저 걸 것.
ANTHROPIC_API_KEY=sk-ant-...
# 모델 오버라이드(선택). 기본값은 전부 Sonnet 5. 비용을 더 아끼려면 아래 주석을
# 풀어 intake chat + 키워드 추출만 Haiku로 내릴 수 있다(합성은 Sonnet 유지).
# LLM_EXTRACT_MODEL=claude-haiku-4-5

# ─── 임베딩 ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ─── 알림 ─────────────────────────────────────────────────────────────────────
RESEND_API_KEY=re_...
SOLAPI_API_KEY=...
SOLAPI_API_SECRET=...
