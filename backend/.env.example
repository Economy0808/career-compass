# 이 파일을 복사해서 .env로 만드세요: cp .env.example .env
# .env는 절대 커밋하지 마세요 (.gitignore에 포함됨)

# ─── 앱 설정 ──────────────────────────────────────────────────────────────────
APP_ENV=development
APP_VERSION=0.1.0
SECRET_KEY=change-me-to-a-random-32-char-string

# ─── 데이터베이스 ─────────────────────────────────────────────────────────────
# Docker Compose 기본값 (로컬 개발용)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ourcompass

# ─── LLM ──────────────────────────────────────────────────────────────────────
# 로드맵 생성용 Anthropic 키. 비워두거나 "sk-ant-..." 플레이스홀더면 Mock(무료)로
# 동작한다. console.anthropic.com 에서 발급 후 여기에 넣고, 반드시 콘솔에서
# 월 지출 한도(Usage limits)를 먼저 걸 것.
ANTHROPIC_API_KEY=sk-ant-...
# 모델 오버라이드(선택). 기본값은 전부 Sonnet 5. 비용을 더 아끼려면 아래 주석을
# 풀어 intake chat + 키워드 추출만 Haiku로 내릴 수 있다(합성은 Sonnet 유지).
# LLM_EXTRACT_MODEL=claude-haiku-4-5
# 품질 실험용: 합성 모델을 Opus로 올리고 웹 검색을 허용(생성 1회 수백 원 수준).
# LLM_SYNTHESIS_MODEL=claude-opus-4-8
# LLM_SYNTHESIS_WEB_SEARCH=true

# ─── CORS ─────────────────────────────────────────────────────────────────────
# 세션/Bearer 토큰을 보내도 되는 프론트 origin 화이트리스트. 콤마로 여러 개
# 지정 (app/config.py의 cors_allowed_origins가 콤마로 split한다).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ─── Firebase 에뮬레이터 (로컬 개발/테스트 전용) ────────────────────────────────
# firebase emulators:exec 가 자동으로 export하므로 보통 직접 설정할 필요는 없다.
# 에뮬레이터 없이 개별 실행할 때만 아래를 켜서 로컬 emulators:start와 맞춘다.
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
# FIRESTORE_EMULATOR_HOST=localhost:8080
# FIRESTORE_PROJECT_ID=demo-ourlab

# ─── 알림 ─────────────────────────────────────────────────────────────────────
# Resend API 키. "re_..." 플레이스홀더면 실제 발송이 꺼지고 Mock(콘솔 출력)으로
# 떨어진다 — 개발 중에는 백엔드 콘솔에 찍히는 인증 코드를 그대로 쓰면 된다.
RESEND_API_KEY=re_...
# 발신 주소. Resend는 검증된 도메인에서만 발송을 허용한다. 도메인 검증 전에는
# onboarding@resend.dev만 쓸 수 있고 수신자가 Resend 계정 소유자 본인으로
# 제한되므로, 제3자(@yonsei.ac.kr 등)에게 보내려면 도메인 검증이 선행돼야 한다.
# EMAIL_FROM=OurCompass <noreply@your-verified-domain.com>
SOLAPI_API_KEY=...
SOLAPI_API_SECRET=...

# --- 프로필 임베딩 (탐색 검색 벡터 검색, Vertex AI gemini-embedding-001) ---
# 킬 스위치. false로 끄면 발행/bio 수정 시 재임베딩과 탐색 검색의 벡터 합집합을
# 모두 건너뛰고 부분일치 검색만 남는다. 개발/테스트는 app_env로 이미 Fake
# 클라이언트가 강제되므로(app/config.py의 use_real_embeddings), 이 스위치는
# 운영에서 문제가 생겼을 때 즉시 끄는 용도다.
# EMBEDDING_ENABLED=true
# find_nearest()의 COSINE 거리 상한. 배포 후 scripts/probe_profile_search.py로
# 실사용 검색어 거리 분포를 본 뒤 튜닝할 값.
# EMBEDDING_DISTANCE_THRESHOLD=0.45
# 인증은 API 키가 아니라 Google ADC(서비스 계정)라 여기 넣을 키가 없다 - Cloud Run은
# 자동으로 붙는 서비스 계정을 쓰고, 로컬 백필 스크립트는 GCLOUD_ACCESS_TOKEN
# 환경변수(gcloud auth print-access-token)를 쓴다(scripts/backfill_profile_embeddings.py).
